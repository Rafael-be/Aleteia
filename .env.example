# Firebase Admin: cole o JSON inteiro da Service Account em uma única linha.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"seu-projeto"}'

# Firebase Web: configuração pública copiada do Firebase Console > Configuração do SDK.
FIREBASE_WEB_CONFIG_JSON='{"apiKey":"...","authDomain":"seu-projeto.firebaseapp.com","projectId":"seu-projeto","appId":"..."}'

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aleteia
OPENAI_API_KEY=

# Modelo configurável; confirme disponibilidade na conta antes da demonstração.
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
